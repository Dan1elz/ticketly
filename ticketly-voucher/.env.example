# ============================
# Worker voucher (gera o ingresso em PDF + QR code)
# ============================
SERVICE_NAME=ticketly-voucher
LOG_LEVEL=INFO

# ============================
# RabbitMQ (ticketly-infra)
# ============================
# No Docker, "rabbitmq" é o nome do serviço na rede ticketly-net
RABBITMQ_URL=amqp://ticketly:ticketly@rabbitmq:5672/
RABBITMQ_EXCHANGE=ticketly.events
RABBITMQ_QUEUE=voucher.order-paid

# ============================
# Redis (idempotência: processed:{messageId})
# ============================
REDIS_URL=redis://redis:6379/0

# ============================
# MinIO (S3) — onde o PDF é salvo
# ============================
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=ticketly
S3_SECRET_KEY=ticketly-secret
S3_BUCKET=ticketly-documents

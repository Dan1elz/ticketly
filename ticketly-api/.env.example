# ============================
# Banco de Dados (container Postgres)
# ============================
POSTGRES_USER=ticketly_user
POSTGRES_PASSWORD=ticketly_password
POSTGRES_DB=ticketly_db
DB_TIMEZONE=America/Sao_Paulo
# Porta do Postgres no seu PC (5433 pra não brigar com um Postgres local na 5432)
POSTGRES_PORT=5433

# ============================
# API (NestJS)
# ============================
API_PORT=3000

# Conexão da API com o banco.
# Rodando fora do Docker (npm run start:dev): localhost + POSTGRES_PORT.
# Rodando no Docker: o compose sobrescreve pra DB_HOST=postgres e DB_PORT=5432.
DB_HOST=localhost
DB_PORT=5433
DB_USER=ticketly_user
DB_PASSWORD=ticketly_password
DB_NAME=ticketly_db

# URL do front, liberada no CORS
WEB_URL=http://localhost:5173

# ============================
# Autenticação do admin (JWT)
# ============================
# Gere um valor aleatório longo: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-valor-aleatorio-longo
JWT_EXPIRES_IN=1d

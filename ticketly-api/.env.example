# ============================
# Banco de Dados (container Postgres)
# ============================
POSTGRES_USER=ticketly_user
POSTGRES_PASSWORD=ticketly_password
POSTGRES_DB=ticketly_db
DB_TIMEZONE=America/Sao_Paulo
# Porta do Postgres no 127.0.0.1 (5433 pra não brigar com um Postgres local na 5432)
POSTGRES_PORT=5433

# ============================
# API (NestJS)
# ============================
# Porta da API no 127.0.0.1, só no dev. Na VM o acesso de fora é por https://ticketly-api.zanni.tech
API_PORT=3000

# Usuário do container de dev = dono da pasta no host (o --watch grava o dist/).
# WSL: 1000. VM: 1001 (confira com: id -u; id -g)
HOST_UID=1000
HOST_GID=1000

# Swagger (/docs) fica ligado fora de produção. Em staging (NODE_ENV=production), só com true
SWAGGER_ENABLED=false

# Conexão da API com o banco.
# Rodando fora do Docker (npm run start:dev): localhost + POSTGRES_PORT.
# Rodando no Docker: o compose sobrescreve pra DB_HOST=postgres e DB_PORT=5432.
DB_HOST=localhost
DB_PORT=5433
DB_USER=ticketly_user
DB_PASSWORD=ticketly_password
DB_NAME=ticketly_db

# Origem(ns) do front liberada(s) no CORS, separadas por vírgula. Comparação exata (http ≠ https)
# Local: http://localhost:5173 · VM: https://ticketly.zanni.tech
WEB_URL=http://localhost:5173

# ============================
# Autenticação do admin (JWT)
# ============================
# Gere um valor aleatório longo: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-valor-aleatorio-longo
JWT_EXPIRES_IN=1d

# ============================
# Storage (S3) — fotos dos artistas e PDFs dos pedidos
# ============================
# Rodando fora do Docker (npm run start:dev): localhost.
# Rodando no Docker: o compose sobrescreve pra S3_ENDPOINT_URL=http://storage:9000.
S3_ENDPOINT_URL=http://localhost:9000
# Endereço que o navegador enxerga: monta a URL pública das fotos e das URLs assinadas.
# A assinatura inclui host e caminho: tem que ser exatamente o host que o navegador usa.
# Local: http://localhost:9000 · VM: https://ticketly-s3.zanni.tech (sem porta)
S3_PUBLIC_URL=http://localhost:9000
# Mesmas credenciais do STORAGE_ROOT_* no .env do ticketly-infra
S3_ACCESS_KEY=ticketly
S3_SECRET_KEY=ticketly-secret
S3_BUCKET_PUBLIC=ticketly-public
S3_BUCKET_DOCUMENTS=ticketly-documents
# O SDK exige uma região; o storage ignora
S3_REGION=us-east-1

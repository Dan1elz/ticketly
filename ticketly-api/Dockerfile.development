FROM node:24-alpine

WORKDIR /app

ENV NODE_ENV=development \
    PORT=3000

# Roda como o usuário 'node' com o MESMO uid/gid do dono da pasta no host
# (1000 no WSL, 1001 na VM; vem do compose). Como root, o dist/ que o --watch gera na
# pasta montada ficaria com dono root; com outro uid, o --watch nem consegue gravar
ARG UID=1000
ARG GID=1000
RUN apk add --no-cache shadow \
    && groupmod -o -g "$GID" node \
    && usermod -o -u "$UID" -g "$GID" node \
    && chown -R node:node /app /home/node \
    && apk del shadow
USER node

# Cache layer: instalar dependências antes de copiar o código
# Isso faz o primeiro start ser mais rápido
COPY --chown=node:node package.json package-lock.json ./
RUN npm install

EXPOSE 3000

# GET /health responde 200 só se a API está no ar E alcança o banco
HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=5 \
    CMD wget -q -O /dev/null http://127.0.0.1:3000/health || exit 1

# O código vem pelo volume do compose; o --watch recompila a cada alteração
CMD ["npm", "run", "start:dev"]

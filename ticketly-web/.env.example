# ==========================================
# FRONTEND (REACT/VITE)
# ==========================================
# Porta do nginx no staging (no dev é sempre 5173)
FRONTEND_PORT=80

# URL da API que o Frontend vai chamar (Browser -> ticketly-api)
# É o navegador que chama, então tem que ser um endereço acessível de fora do Docker
# Em Dev local: http://localhost:3000
# Em Staging: https://api.seu-dominio.com
VITE_API_URL=http://localhost:3000

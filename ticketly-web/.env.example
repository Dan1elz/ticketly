# ==========================================
# FRONTEND (REACT/VITE)
# ==========================================
# URL da API que o Frontend vai chamar (Browser -> ticketly-api)
# É o navegador que chama, então tem que ser um endereço acessível de fora do Docker.
# Página em https só pode chamar https (senão o navegador bloqueia: "conteúdo misto").
# Local: http://localhost:3000
# VM:    https://ticketly-api.zanni.tech
# No staging o valor entra no BUILD da imagem: mudou, reconstrua (--build)
VITE_API_URL=http://localhost:3000

# Só dev: hostnames extras aceitos pelo Vite, separados por vírgula (localhost sempre vale)
# VM: ticketly.zanni.tech
ALLOWED_HOSTS=
